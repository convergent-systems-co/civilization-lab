{
  "name": "civilization-lab",
  "version": "0.1.0-pilot0",
  "private": true,
  "description": "Specification-first CivilizationLab Pilot 0 apparatus",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "validate": "node scripts/validate-contracts.js",
    "validate:calibration": "node --test --test-concurrency=1 test/calibration-protocol.test.js",
    "calibration:plan": "node scripts/calibration-cli.js plan",
    "calibration:verify": "node scripts/calibration-cli.js verify",
    "calibration:trust:provision": "node scripts/calibration-trust-provision.js provision",
    "calibration:evidence:serve": "node scripts/calibration-evidence-authority.js",
    "calibration:evidence:probe": "node scripts/calibration-evidence-commit-probe.js",
    "calibration:trust:audit": "node scripts/calibration-authority-trust-audit.js",
    "calibration:trust:preflight": "node scripts/calibration-trust-preflight.js",
    "test": "node --test --test-concurrency=4",
    "check": "npm run validate && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
