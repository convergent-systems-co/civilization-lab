{
  "schema_version": "1.0.0",
  "protocol_id": "pilot_0_world_calibration",
  "protocol_version": "pilot-0-calibration-1.0.0",
  "status": "FROZEN_BEFORE_EMPIRICAL_CALIBRATION",
  "scope": "Treatment-blind Phase A selection of viable provisional world parameters, followed by a separately frozen Phase B exploratory Pilot 0; no empirical execution or treatment inference is authorized by this file.",
  "phases": [
    {"phase_id":"A_WORLD_CALIBRATION","purpose":"Select a viable world using only frozen treatment-neutral mechanics, feasibility and measurement-opportunity metrics.","parameter_state":"PROVISIONAL_SEARCH_WITH_COMPLETE_ATTEMPT_RETENTION","treatment_analysis":"PROHIBITED"},
    {"phase_id":"B_FROZEN_PILOT_0","purpose":"Freeze the selected parameter set before exploratory Pilot 0 instrumentation, variance and design-preparation work.","parameter_state":"FROZEN_FOR_VERSIONED_PILOT_0_DATASET","treatment_analysis":"EXPLORATORY_ONLY_AFTER_PHASE_A_SELECTION_IS_FINAL"}
  ],
  "allowed_objectives": ["world_viability","contact_opportunity","meaningful_interaction_opportunity","avoid_immediate_collapse","avoid_universal_stalemate","avoid_dominant_degenerate_strategies","consequential_resource_pressure","nontrivial_technology_progression","useful_population_unit_dynamics","nontrivial_nonannihilating_conflict","information_detection_dynamics","memory_runtime_feasibility","phase_action_bandwidth","computational_feasibility","endpoint_measurement_opportunity"],
  "forbidden_objectives": ["persistence_treatment_effect","between_arm_difference","statistical_significance","treatment_effect_size","theory_support","persistence_benefit","persistence_harm","treatment_cooperation_advantage","treatment_commitment_advantage","treatment_repair_advantage","treatment_reciprocity_advantage","theoretical_attractiveness"],
  "blinding": {
    "selection_view": "CALIBRATION_TREATMENT_BLIND_V1",
    "forbidden_input_fields": ["treatment","treatment_arm","condition_id","persistence","persistence_condition","history_access","memory_treatment","primary_endpoint","endpoint_value","estimand","effect_size","p_value","confidence_interval","significance","arm_summary"],
    "forbidden_outputs": ["treatment_comparison","arm_specific_metric","primary_endpoint_by_arm","effect_estimate","p_value","significance","persistence_outcome_direction"],
    "incident_policy": "Any attempted or accidental disclosure is retained as CALIBRATION_PROTOCOL_INCIDENT; the affected selection decision is invalid and must be repeated from the last unexposed state.",
    "pooling": "If experimental agents are required, metrics are pooled before evaluator access and run identifiers are replaced by protocol-scoped blinded identifiers. Raw canonical evidence retains provenance under a separate authorization domain."
  },
  "seed_panel": {
    "method": "FROZEN_COMMON_SEED_PANEL",
    "seeds": ["calibration-seed-00","calibration-seed-01","calibration-seed-02","calibration-seed-03","calibration-seed-04","calibration-seed-05","calibration-seed-06","calibration-seed-07","calibration-seed-08","calibration-seed-09","calibration-seed-10","calibration-seed-11","calibration-seed-12","calibration-seed-13","calibration-seed-14","calibration-seed-15","calibration-seed-16","calibration-seed-17","calibration-seed-18","calibration-seed-19","calibration-seed-20","calibration-seed-21","calibration-seed-22","calibration-seed-23"],
    "minimum_seed_count": 24,
    "cherry_picking_policy": "ALL_SEEDS_RETAINED_AND_REPORTED"
  },
  "metrics": [
    {"metric_id":"viability.median_continuation_turn","domain":"WORLD_VIABILITY","unit":"turn","aggregation":"median across complete seed panel","acceptance":{"minimum":16},"pathology":"Initialization collapse leaves inadequate longitudinal opportunity.","treatment_effect_metric":false},
    {"metric_id":"viability.premature_absorbing_rate","domain":"WORLD_VIABILITY","unit":"proportion_runs","aggregation":"runs absorbed before turn 16 / all runs","acceptance":{"maximum":0.20},"pathology":"Frequent early absorption truncates the apparatus.","treatment_effect_metric":false},
    {"metric_id":"viability.distinct_state_trajectory_rate","domain":"WORLD_VIABILITY","unit":"proportion_unique_trajectory_hashes","aggregation":"unique canonical turn-state trajectories / all runs","acceptance":{"minimum":0.50},"pathology":"Universal deterministic collapse or stalemate produces no dynamic range.","treatment_effect_metric":false},
    {"metric_id":"contact.median_first_contact_turn","domain":"CONTACT","unit":"turn","aggregation":"median among runs with contact; zero-contact runs retained separately","acceptance":{"maximum":7},"pathology":"Contact occurs too late for repeated interaction.","treatment_effect_metric":false},
    {"metric_id":"contact.mean_post_contact_events_per_turn","domain":"CONTACT","unit":"events_per_turn","aggregation":"mean canonical contact/message/exchange/hostile interactions after first contact","acceptance":{"minimum":0.25,"maximum":12},"pathology":"Permanent isolation or mechanically forced interaction saturation.","treatment_effect_metric":false},
    {"metric_id":"contact.meaningful_multi_polity_run_rate","domain":"CONTACT","unit":"proportion_runs","aggregation":"runs with at least two distinct cross-polity research-relevant interactions / all runs","acceptance":{"minimum":0.75},"pathology":"Most runs never support relational observation.","treatment_effect_metric":false},
    {"metric_id":"economy.median_production_consumption_ratio","domain":"ECONOMY","unit":"ratio","aggregation":"median pooled per-run produced consumables / consumed consumables","acceptance":{"minimum":0.70,"maximum":1.50},"pathology":"Guaranteed abundance or unavoidable depletion.","treatment_effect_metric":false},
    {"metric_id":"economy.insolvency_or_collapse_rate","domain":"ECONOMY","unit":"proportion_runs","aggregation":"runs with irreversible economy-caused incapacity / all runs","acceptance":{"maximum":0.25},"pathology":"Resource system routinely prevents meaningful choice.","treatment_effect_metric":false},
    {"metric_id":"economy.unused_resource_saturation_rate","domain":"ECONOMY","unit":"proportion_run_turns","aggregation":"eligible run-turns at registered maximum or with no consequential spend path / eligible run-turns","acceptance":{"maximum":0.25},"pathology":"Resources cease constraining decisions.","treatment_effect_metric":false},
    {"metric_id":"technology.median_first_completion_turn","domain":"TECHNOLOGY","unit":"turn","aggregation":"median first completed technology; no-completion runs retained","acceptance":{"minimum":3,"maximum":12},"pathology":"Technology is instant or unavailable within the horizon.","treatment_effect_metric":false},
    {"metric_id":"technology.no_completion_rate","domain":"TECHNOLOGY","unit":"proportion_runs","aggregation":"runs with no technology completion / all runs","acceptance":{"maximum":0.40},"pathology":"Progression is commonly unreachable.","treatment_effect_metric":false},
    {"metric_id":"technology.trivial_completion_rate","domain":"TECHNOLOGY","unit":"proportion_runs","aggregation":"runs completing a technology before turn 3 / all runs","acceptance":{"maximum":0.10},"pathology":"Progression is effectively free or immediate.","treatment_effect_metric":false},
    {"metric_id":"population.recruitment_feasible_run_rate","domain":"POPULATION_UNITS","unit":"proportion_runs","aggregation":"runs with at least one valid recruitment opportunity / all runs","acceptance":{"minimum":0.50},"pathology":"Unit creation is structurally unavailable.","treatment_effect_metric":false},
    {"metric_id":"population.depletion_rate","domain":"POPULATION_UNITS","unit":"proportion_runs","aggregation":"runs losing at least 75 percent of starting affiliated population before turn 16 / all runs","acceptance":{"maximum":0.25},"pathology":"Population mechanics routinely erase actors.","treatment_effect_metric":false},
    {"metric_id":"population.unit_saturation_rate","domain":"POPULATION_UNITS","unit":"proportion_run_turns","aggregation":"run-turns with more than 60 percent of affiliated population in units / eligible run-turns","acceptance":{"maximum":0.35},"pathology":"Military conversion dominates population ontology.","treatment_effect_metric":false},
    {"metric_id":"population.casualty_recovery_rate","domain":"POPULATION_UNITS","unit":"proportion_eligible_losses","aggregation":"eligible unit losses followed by demobilization/recovery transition / eligible losses","acceptance":{"minimum":0.05,"maximum":0.90},"pathology":"Losses are either consequence-free or universally irreversible.","treatment_effect_metric":false},
    {"metric_id":"conflict.mean_battles_per_run","domain":"CONFLICT","unit":"battles_per_run","aggregation":"mean canonical battles across all runs including zeros","acceptance":{"minimum":0.25,"maximum":8},"pathology":"No conflict opportunity or perpetual combat.","treatment_effect_metric":false},
    {"metric_id":"conflict.annihilation_rate","domain":"CONFLICT","unit":"proportion_runs","aggregation":"runs with polity annihilation before turn 16 / all runs","acceptance":{"maximum":0.25},"pathology":"Combat guarantees premature elimination.","treatment_effect_metric":false},
    {"metric_id":"conflict.perpetual_conflict_rate","domain":"CONFLICT","unit":"proportion_runs","aggregation":"runs with battle in at least 8 of final 10 observable turns / all runs","acceptance":{"maximum":0.15},"pathology":"World locks into uninterrupted conflict.","treatment_effect_metric":false},
    {"metric_id":"conflict.dominant_action_share","domain":"CONFLICT","unit":"maximum_action_proportion","aggregation":"largest typed strategic action share across pooled eligible actions","acceptance":{"maximum":0.65},"pathology":"One action is a dominant degenerate strategy indicator.","treatment_effect_metric":false},
    {"metric_id":"information.median_discovery_turn","domain":"INFORMATION","unit":"turn","aggregation":"median first new-polity discovery turn; isolated runs retained","acceptance":{"maximum":8},"pathology":"Information boundaries prevent timely contact.","treatment_effect_metric":false},
    {"metric_id":"information.detection_event_rate","domain":"INFORMATION","unit":"events_per_eligible_turn","aggregation":"canonical detections / eligible run-turns","acceptance":{"minimum":0.05,"maximum":0.80},"pathology":"Detection never functions or reveals nearly everything.","treatment_effect_metric":false},
    {"metric_id":"information.early_saturation_rate","domain":"INFORMATION","unit":"proportion_runs","aggregation":"runs exposing all discoverable polities before turn 5 / all runs","acceptance":{"maximum":0.15},"pathology":"Discovery is trivial at initialization.","treatment_effect_metric":false},
    {"metric_id":"information.permanent_isolation_rate","domain":"INFORMATION","unit":"proportion_runs","aggregation":"runs with no discovered external polity by turn 12 / all runs","acceptance":{"maximum":0.20},"pathology":"Some worlds permanently prevent interaction.","treatment_effect_metric":false},
    {"metric_id":"bandwidth.action_budget_utilization","domain":"INTERACTION_BANDWIDTH","unit":"proportion_capacity","aggregation":"accepted non-wait actions / registered available action slots","acceptance":{"minimum":0.15,"maximum":0.90},"pathology":"Phase limit suppresses action or capacity is largely irrelevant.","treatment_effect_metric":false},
    {"metric_id":"bandwidth.phase_limit_block_rate","domain":"INTERACTION_BANDWIDTH","unit":"proportion_attempts","aggregation":"otherwise valid actions rejected solely by phase/action limits / eligible attempts","acceptance":{"maximum":0.15},"pathology":"Interaction opportunity is artificially throttled.","treatment_effect_metric":false},
    {"metric_id":"runtime.deadline_failure_rate","domain":"COMPUTATIONAL_FEASIBILITY","unit":"proportion_invocations","aggregation":"deadline/model-runtime failures / attempted invocations, pooled and blinded","acceptance":{"maximum":0.05},"pathology":"Runtime limits systematically remove action opportunity.","treatment_effect_metric":false},
    {"metric_id":"relational.median_commitment_opportunities","domain":"RELATIONAL_MEASUREMENT_OPPORTUNITY","unit":"opportunities_per_run","aggregation":"median treatment-blind eligible commitment opportunities per run","acceptance":{"minimum":2},"pathology":"Commitment component is usually unobservable.","treatment_effect_metric":false},
    {"metric_id":"relational.median_reciprocity_opportunities","domain":"RELATIONAL_MEASUREMENT_OPPORTUNITY","unit":"opportunities_per_run","aggregation":"median eligible initiating relational actions with observation window per run","acceptance":{"minimum":3},"pathology":"Reciprocity component lacks repeated opportunities.","treatment_effect_metric":false},
    {"metric_id":"relational.rupture_opportunity_run_rate","domain":"RELATIONAL_MEASUREMENT_OPPORTUNITY","unit":"proportion_runs","aggregation":"runs with at least one eligible rupture and repair observation opportunity / all runs","acceptance":{"minimum":0.30},"pathology":"Repair behavior cannot be observed in nearly all runs.","treatment_effect_metric":false},
    {"metric_id":"relational.repeated_interaction_density","domain":"RELATIONAL_MEASUREMENT_OPPORTUNITY","unit":"linked_interactions_per_observable_turn","aggregation":"mean repeated same-dyad interactions / observable post-contact turns","acceptance":{"minimum":0.20},"pathology":"Interactions remain one-shot rather than longitudinal.","treatment_effect_metric":false},
    {"metric_id":"relational.zero_opportunity_run_rate","domain":"RELATIONAL_MEASUREMENT_OPPORTUNITY","unit":"proportion_runs","aggregation":"runs ZERO_OPPORTUNITY on all A/B/C endpoint opportunity classes / all runs","acceptance":{"maximum":0.40},"pathology":"World cannot measure the registered endpoint components.","treatment_effect_metric":false}
  ],
  "metric_numeric_policy": {"representation":"SIGNED_FIXED_POINT_INTEGER","scale":1000000,"rounding":"ROUND_HALF_EVEN","overflow":"FAIL_CLOSED"},
