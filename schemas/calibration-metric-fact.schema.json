{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "numerator",
    "denominator",
    "eligibility_count",
    "value",
    "scaled_value",
    "definition_hash"
  ],
  "properties": {
    "status": {
      "enum": [
        "OBSERVED",
        "ZERO_OPPORTUNITY",
        "CENSORED",
        "UNEVALUABLE"
      ]
    },
    "numerator": {
      "type": "string",
      "pattern": "^-?[0-9]+$"
    },
    "denominator": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "eligibility_count": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "scaled_value": {
      "type": ["string", "null"],
      "pattern": "^-?[0-9]+$"
    },
    "category_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "definition_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "note": {
      "type": "string"
    }
  }
}
