  "properties": {
    "schema_version": {"type": "string"}, "operation_id": {"type": "string"}, "run_id": {"type": "string"}, "identity_ref": {"type": "string"}, "session_ref": {"type": "string"}, "invocation_ref": {"type": "string"}, "operation": {"enum": ["read", "write", "edit", "compress", "evict", "recover", "clear"]}, "input_refs": {"type": "array", "items": {"type": "string"}}, "output_ref": {"type": ["string", "null"]}, "capacity_before": {"type": "object"}, "capacity_after": {"type": "object"}, "ordering_rule": {"type": "string"}, "deterministic": {"const": true}, "availability_ref": {"type": "string"}
  }
