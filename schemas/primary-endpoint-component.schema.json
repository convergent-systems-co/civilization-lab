{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civilization-lab.invalid/schemas/primary-endpoint-component.schema.json",
  "title": "CivilizationLab Primary Endpoint Component",
  "type": "object",
  "additionalProperties": false,
  "required": ["component_id", "name", "source", "definition", "denominator", "grain", "coordinates"],
  "properties": {
    "component_id": {"enum": ["A","B","C","D"]}, "name": {"type":"string","minLength":1}, "source":{"type":"string","minLength":1}, "definition":{"type":"string","minLength":10}, "denominator":{"type":"string","minLength":5}, "grain":{"const":"run"}, "coordinates":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}}, "coding_contract":{"const":"ENDPOINT_CODEBOOK.spec.md"}
  }
}
