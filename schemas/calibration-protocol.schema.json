{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civilization-lab.invalid/schemas/calibration-protocol.schema.json",
  "title": "Pilot 0 treatment-blind calibration protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "protocol_version", "status", "scope", "phases", "allowed_objectives", "forbidden_objectives", "blinding", "seed_panel", "metrics", "metric_numeric_policy", "metric_aggregation_registry", "parameter_domains", "held_constant_registry_parameters", "deferred_parameter_domains", "search_procedure", "stopping_rule", "provenance_requirements", "authorization"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "protocol_id": {"const": "pilot_0_world_calibration"},
    "protocol_version": {"type": "string", "minLength": 1},
    "status": {"const": "FROZEN_BEFORE_EMPIRICAL_CALIBRATION"},
    "scope": {"type": "string", "minLength": 1},
    "phases": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["phase_id", "purpose", "parameter_state", "treatment_analysis"], "properties": {"phase_id": {"enum": ["A_WORLD_CALIBRATION", "B_FROZEN_PILOT_0"]}, "purpose": {"type": "string"}, "parameter_state": {"type": "string"}, "treatment_analysis": {"type": "string"}}}},
    "allowed_objectives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "forbidden_objectives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "blinding": {"type": "object", "additionalProperties": false, "required": ["selection_view", "forbidden_input_fields", "forbidden_outputs", "incident_policy", "pooling"], "properties": {"selection_view": {"const": "CALIBRATION_TREATMENT_BLIND_V1"}, "forbidden_input_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "forbidden_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "incident_policy": {"type": "string"}, "pooling": {"type": "string"}}},
    "seed_panel": {"type": "object", "additionalProperties": false, "required": ["method", "seeds", "minimum_seed_count", "cherry_picking_policy"], "properties": {"method": {"const": "FROZEN_COMMON_SEED_PANEL"}, "seeds": {"type": "array", "minItems": 24, "uniqueItems": true, "items": {"type": "string"}}, "minimum_seed_count": {"type": "integer", "minimum": 24}, "cherry_picking_policy": {"const": "ALL_SEEDS_RETAINED_AND_REPORTED"}}},
    "metrics": {"type": "array", "minItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["metric_id", "domain", "unit", "aggregation", "acceptance", "pathology", "treatment_effect_metric"], "properties": {"metric_id": {"type": "string"}, "domain": {"enum": ["WORLD_VIABILITY", "CONTACT", "ECONOMY", "TECHNOLOGY", "POPULATION_UNITS", "CONFLICT", "INFORMATION", "INTERACTION_BANDWIDTH", "RELATIONAL_MEASUREMENT_OPPORTUNITY", "COMPUTATIONAL_FEASIBILITY"]}, "unit": {"type": "string"}, "aggregation": {"type": "string"}, "acceptance": {"type": "object", "additionalProperties": false, "properties": {"minimum": {"type": "number"}, "maximum": {"type": "number"}}}, "pathology": {"type": "string"}, "treatment_effect_metric": {"const": false}}}},
    "metric_numeric_policy": {"type": "object", "additionalProperties": false, "required": ["representation", "scale", "rounding", "overflow"], "properties": {"representation": {"const": "SIGNED_FIXED_POINT_INTEGER"}, "scale": {"const": 1000000}, "rounding": {"const": "ROUND_HALF_EVEN"}, "overflow": {"const": "FAIL_CLOSED"}}},
    "metric_aggregation_registry": {"type": "object", "additionalProperties": {"enum": ["MEAN", "MEDIAN", "MAXIMUM"]}},
    "parameter_domains": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["domain_id", "registry_parameter_id", "selector", "starting_value", "allowed_domain", "search_operator", "calibration_metrics", "pathological_bounds", "stopping_condition"], "properties": {"domain_id": {"type": "string"}, "registry_parameter_id": {"type": "string"}, "selector": {"type": "string"}, "starting_value": {}, "allowed_domain": {"type": "object"}, "search_operator": {"enum": ["FIXED_GRID_COORDINATE", "FIXED_ENUMERATION", "HELD_GROUP_RATIO_GRID"]}, "calibration_metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "pathological_bounds": {"type": "string"}, "stopping_condition": {"type": "string"}}}},
    "held_constant_registry_parameters": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "deferred_parameter_domains": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["gate","registry_parameter_ids","initial_phase_a_status","retuning_authorized"],"properties":{"gate":{"const":"SEPARATELY_AUTHORIZED_BLINDED_QWEN_ECOLOGICAL_VALIDATION"},"registry_parameter_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["model.generation","model.context_budget","model.retry"]}},"initial_phase_a_status":{"const":"HELD_UNSEARCHED"},"retuning_authorized":{"const":false}}}},
    "search_procedure": {"type": "object", "additionalProperties": false, "required": ["algorithm", "maximum_parameter_sets", "maximum_rounds", "candidate_generation", "attempt_retention", "manual_tuning", "treatment_outputs_available"], "properties": {"algorithm": {"const": "BOUNDED_DETERMINISTIC_COORDINATE_GRID"}, "maximum_parameter_sets": {"type": "integer", "minimum": 1}, "maximum_rounds": {"type": "integer", "minimum": 1}, "candidate_generation": {"type": "string"}, "attempt_retention": {"const": "PRESERVE_ALL_ACCEPTED_REJECTED_AND_FAILED_ATTEMPTS"}, "manual_tuning": {"const": "PROHIBITED_OUTSIDE_NEW_PROTOCOL_VERSION"}, "treatment_outputs_available": {"const": false}}},
    "stopping_rule": {"type": "object", "additionalProperties": false, "required": ["acceptance", "selection", "tie_breakers", "failure", "effect_information_used"], "properties": {"acceptance": {"const": "ALL_FROZEN_METRIC_RANGES_PASS_ON_COMPLETE_SEED_PANEL"}, "selection": {"const": "MAXIMIZE_MINIMUM_NORMALIZED_DISTANCE_FROM_PATHOLOGICAL_BOUNDARIES"}, "tie_breakers": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "failure": {"const": "STOP_CALIBRATION_AND_REQUIRE_VERSIONED_PROTOCOL_REVISION"}, "effect_information_used": {"const": false}}},
    "provenance_requirements": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string"}},
    "authorization": {"type": "object", "additionalProperties": false, "required": ["empirical_calibration", "pilot_0_research", "confirmatory_execution"], "properties": {"empirical_calibration": {"const": false}, "pilot_0_research": {"const": false}, "confirmatory_execution": {"const": false}}}
  }
}
