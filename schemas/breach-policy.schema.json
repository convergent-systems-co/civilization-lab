{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civilization-lab.invalid/schemas/breach-policy.schema.json",
  "title": "CivilizationLab Breach Analytical Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "evidence_validity", "experimental_validity", "endpoint_eligibility", "security_eligibility", "exploratory_only", "replacement_policy", "evidence_completeness"],
  "properties": {"schema_version": {"type": "string"}, "policy_version": {"type": "string"}, "evidence_validity": {"type": "object", "required": ["canonical_record_accurate"]}, "experimental_validity": {"type": "object", "required": ["confirmatory_eligible"]}, "endpoint_eligibility": {"type": "object", "required": ["primary_confirmatory"]}, "security_eligibility": {"type": "object", "required": ["security_analysis_eligible"]}, "exploratory_only": {"const": true}, "replacement_policy": {"type": "object"}, "evidence_completeness": {"type": "object", "required": ["status"]}}
}
