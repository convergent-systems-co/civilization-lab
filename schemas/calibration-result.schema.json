{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civilization-lab.invalid/schemas/calibration-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "result_type", "execution_mode", "evidence_class", "protocol_version", "protocol_hash", "parameter_registry_hash",
    "implementation_commit", "implementation_tag", "tooling_distribution_digest", "baseline_tag_commit",
    "release_descriptor_hash", "policy_package_id", "policy_package_version", "policy_package_hash", "policy_assignment_hashes", "selected_parameter_vector", "selected_parameter_set_hash",
    "all_attempt_manifest_hashes", "candidate_attestation_hashes", "attempted_parameter_vectors",
    "evaluated_seeds", "acceptance_metrics", "thresholds_hash", "stopping_rule_hash",
    "stopping_rule_satisfied", "stopping_rule_proof", "search_history", "rejected_configurations",
    "provenance", "blinding_attestation", "incidents", "calibration_execution_authorized",
    "pilot0_research_authorized", "confirmatory_authorized", "artifact_attestation"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "result_type": {"enum": ["CALIBRATION_RESULT", "CALIBRATION_CONFORMANCE_RESULT"]},
    "execution_mode": {"enum": ["SYNTHETIC_CONFORMANCE", "EMPIRICAL_CALIBRATION"]},
    "evidence_class": {"enum": ["SYNTHETIC_SOFTWARE_CONFORMANCE", "EMPIRICAL_CALIBRATION_EVIDENCE"]},
    "protocol_version": {"type": "string"},
    "protocol_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parameter_registry_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "implementation_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "implementation_tag": {"const": "v0.1.0-pilot0"},
    "tooling_distribution_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline_tag_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release_descriptor_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "policy_package_id": {"const": "civilizationlab-phase-a-coverage-panel"},
    "policy_package_version": {"const": "phase-a-policy-panel-1.0.0"},
    "policy_package_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_assignment_hashes": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "selected_parameter_vector": {"type": "object"},
    "selected_parameter_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "all_attempt_manifest_hashes": {"type": "array", "items": {"type": "string"}},
    "candidate_attestation_hashes": {"type": "array", "items": {"type": "string"}},
    "attempted_parameter_vectors": {"type": "integer", "minimum": 1},
    "evaluated_seeds": {"type": "array", "minItems": 24, "uniqueItems": true, "items": {"type": "string"}},
    "acceptance_metrics": {"type": "object", "additionalProperties": {"type": "number"}},
    "thresholds_hash": {"type": "string"},
    "stopping_rule_hash": {"type": "string"},
    "stopping_rule_satisfied": {"const": true},
    "stopping_rule_proof": {"type": "object"},
    "search_history": {"type": "array"},
    "rejected_configurations": {"type": "array"},
    "provenance": {"type": "object"},
    "blinding_attestation": {"type": "string"},
    "incidents": {"type": "array"},
    "calibration_execution_authorized": {"type": "boolean"},
    "pilot0_research_authorized": {"const": false},
    "confirmatory_authorized": {"const": false},
    "artifact_attestation": {"type": "object"}
  }
}
