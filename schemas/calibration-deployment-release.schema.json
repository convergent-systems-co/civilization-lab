{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calibration-deployment-release.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "issued_at", "tooling_version", "tooling_distribution_digest", "tooling_distribution_manifest_hash", "baseline_tag", "baseline_tag_commit", "protocol_preparation_commit", "calibration_tooling_commit", "calibration_tooling_implementation_commit", "protocol_version", "protocol_hash", "parameter_registry_version", "parameter_registry_hash", "policy_package_id", "policy_package_version", "policy_package_hash", "schema_distribution_hash", "event_catalogue_version", "event_catalogue_hash", "deployment_manifest_hash", "deployment_trust_policy_hash", "authorization_key_id", "approved_adapter_package_digest", "public_key", "signature"],
  "properties": {
    "version": {"const": "phase-a-calibration-release-1.0.0"},
    "issued_at": {"type": "string", "minLength": 20},
    "tooling_version": {"const": "phase-a-calibration-tooling-1.1.0"},
    "tooling_distribution_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tooling_distribution_manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baseline_tag": {"const": "v0.1.0-pilot0"},
    "baseline_tag_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "protocol_preparation_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "calibration_tooling_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "calibration_tooling_implementation_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "protocol_version": {"type": "string", "minLength": 1},
    "protocol_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parameter_registry_version": {"type": "string", "minLength": 1},
    "parameter_registry_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_package_id": {"type": "string", "minLength": 1},
    "policy_package_version": {"type": "string", "minLength": 1},
    "policy_package_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "schema_distribution_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "event_catalogue_version": {"type": "string", "minLength": 1},
    "event_catalogue_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "deployment_manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "deployment_trust_policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authorization_key_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approved_adapter_package_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "public_key": {"type": "string", "minLength": 80},
    "signature": {"type": "string", "minLength": 80}
  }
}
