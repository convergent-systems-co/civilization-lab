{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civilization-lab.invalid/schemas/experiment-freeze.schema.json",
  "title": "CivilizationLab Confirmatory Experiment Freeze",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_version", "study", "hypotheses", "conditions", "primary_endpoint", "secondary_endpoints", "exclusions", "missing_data", "multiplicity", "stopping", "transformations", "models", "coding", "sensitivity", "boundaries", "artifacts", "authority"],
  "properties": {
    "schema_version": {"type": "string"},
    "experiment_version": {"type": "string"},
    "parent_experiment_version": {"type": ["string", "null"]},
    "study": {"type": "object", "required": ["study_id", "claim", "unit", "assignment_unit", "target_population", "interference", "organization_scope"], "additionalProperties": false, "properties": {"study_id": {"type": "string"}, "claim": {"type": "string"}, "unit": {"enum": ["run"]}, "assignment_unit": {"enum": ["run", "polity", "agent"]}, "target_population": {"type": "object"}, "interference": {"type": "object", "required": ["allowed", "exposure_mapping", "estimands", "analysis_model"]}, "organization_scope": {"type": "object", "required": ["formal_mechanics_enabled", "emergent_social_behavior_allowed", "system_entity_absent"], "properties": {"formal_mechanics_enabled": {"const": false}, "emergent_social_behavior_allowed": {"const": true}, "system_entity_absent": {"const": true}}}}},
    "hypotheses": {"type": "array", "items": {"type": "object", "required": ["id", "statement", "contrast", "estimand", "claim_boundary"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "statement": {"type": "string"}, "contrast": {"type": "object"}, "estimand": {"type": "object"}, "claim_boundary": {"type": "object"}}}},
    "conditions": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["condition_id", "agent_condition_ref", "declared_treatments", "invariants"], "additionalProperties": false, "properties": {"condition_id": {"type": "string"}, "agent_condition_ref": {"type": "string"}, "declared_treatments": {"type": "array"}, "invariants": {"type": "array"}}}},
    "primary_endpoint": {"type": "object", "required": ["metric_id", "kind", "components", "component_registry_hash", "standardization", "weighting", "directionality", "inference", "calculation", "denominator", "temporal_aggregation", "missingness", "sensitivity_analysis", "multiplicity_family"], "additionalProperties": false, "properties": {"metric_id": {"type": "string"}, "kind": {"const": "composite_longitudinal_relational_behavior"}, "components": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["component_id", "metric_ref", "evidence_level", "run_aggregation_ref", "declared_orientation"]}}, "component_registry_hash": {"type": "string"}, "standardization": {"type": "object", "required": ["procedure", "reference_manifest_hash"]}, "weighting": {"type": "object", "required": ["policy", "equal_after_standardization"], "properties": {"policy": {"const": "equal_after_standardization"}, "equal_after_standardization": {"const": true}}}, "directionality": {"type": "object", "required": ["interpretation", "normative_improvement_claim_permitted"], "properties": {"interpretation": {"const": "magnitude_or_pattern_of_longitudinal_relational_behavior"}, "normative_improvement_claim_permitted": {"const": false}}}, "inference": {"type": "object", "required": ["directionality", "decision_rule"], "properties": {"directionality": {"const": "two_sided_non_directional"}, "decision_rule": {"type": "string"}}}, "calculation": {"type": "object"}, "denominator": {"type": "object"}, "temporal_aggregation": {"type": "object"}, "missingness": {"type": "object"}, "sensitivity_analysis": {"type": "object", "required": ["individual_components", "alternative_weighting_schemes"]}, "multiplicity_family": {"type": "string"}}},
    "secondary_endpoints": {"type": "array", "items": {"type": "object"}},
    "exclusions": {"type": "object"},
    "missing_data": {"type": "object"},
    "multiplicity": {"type": "object"},
    "stopping": {"type": "object"},
    "transformations": {"type": "array", "items": {"type": "object"}},
    "models": {"type": "array", "items": {"type": "object"}},
    "coding": {"type": "array", "items": {"type": "object"}},
    "sensitivity": {"type": "array", "items": {"type": "object"}},
    "boundaries": {"type": "object"},
    "artifacts": {"type": "object", "required": ["spec_hashes", "schema_hashes", "analysis_hash", "environment_hash", "model_manifest_hash", "closure_register_hash", "validation_spec_hash", "event_catalogue_hash", "schema_registry_hash", "projection_schema_hash", "redaction_policy_hash", "breach_schema_hash", "codebook_hash", "replay_contract_hash", "parameter_registry_hash", "interference_registry_hash", "primary_component_registry_hash", "endpoint_spec_hash", "horizon_policy_hash"], "additionalProperties": false, "properties": {"spec_hashes": {"type": "object", "required": ["INVARIANTS", "WORLD", "STATISTICS", "EVALUATION"]}, "schema_hashes": {"type": "object"}, "analysis_hash": {"type": "string"}, "environment_hash": {"type": "string"}, "model_manifest_hash": {"type": "string"}, "closure_register_hash": {"type": "string"}, "validation_spec_hash": {"type": "string"}, "event_catalogue_hash": {"type": "string"}, "schema_registry_hash": {"type": "string"}, "projection_schema_hash": {"type": "string"}, "redaction_policy_hash": {"type": "string"}, "breach_schema_hash": {"type": "string"}, "codebook_hash": {"type": "string"}, "replay_contract_hash": {"type": "string"}, "parameter_registry_hash": {"type": "string"}, "interference_registry_hash": {"type": "string"}, "primary_component_registry_hash": {"type": "string"}, "endpoint_spec_hash": {"type": "string"}, "horizon_policy_hash": {"type": "string"}}},
    "authority": {"type": "object", "required": ["approved_by", "approved_at", "amendment_policy"], "additionalProperties": false, "properties": {"approved_by": {"type": "string"}, "approved_at": {"type": "string"}, "amendment_policy": {"type": "string"}}}
  }
}
