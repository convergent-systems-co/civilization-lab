{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calibration-deployment-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deployment_class", "created_at", "authorities", "tls", "deployment_id"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "deployment_class": {"const": "PHASE_A_PRODUCTION_EQUIVALENT_LOCAL"},
    "created_at": {"type": "string", "minLength": 20},
    "deployment_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "calibration_authorization", "archive", "attestation", "evidence", "evidence_head"],
      "properties": {
        "release": {"$ref": "calibration-deployment-public-authority.schema.json"},
        "calibration_authorization": {"$ref": "calibration-deployment-public-authority.schema.json"},
        "archive": {"$ref": "calibration-deployment-public-authority.schema.json"},
        "attestation": {"$ref": "calibration-deployment-public-authority.schema.json"},
        "evidence": {"$ref": "calibration-deployment-public-authority.schema.json"},
        "evidence_head": {"$ref": "calibration-deployment-public-authority.schema.json"}
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "common_name", "dns_names", "ip_addresses", "ca_certificate_file", "ca_certificate_sha256", "server_certificate_file", "server_certificate_sha256"],
      "properties": {
        "transport": {"const": "HTTPS_PRODUCTION_EQUIVALENT_LOCAL"},
        "common_name": {"type": "string", "minLength": 1},
        "dns_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "ip_addresses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "ca_certificate_file": {"type": "string", "minLength": 1},
        "ca_certificate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "server_certificate_file": {"type": "string", "minLength": 1},
        "server_certificate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
