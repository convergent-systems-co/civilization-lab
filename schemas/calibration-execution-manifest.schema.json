{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://civilization-lab.invalid/schemas/calibration-execution-manifest.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","tooling_version","calibration_run_id","attempt_id","implementation_commit","implementation_tag","tooling_distribution_digest","baseline_tag_commit","release_descriptor_hash","protocol_version","protocol_hash","specification_versions","parameter_registry_version","parameter_registry_hash","parameter_set","parameter_set_hash","parameter_classifications","seed","seeds","rng_provenance_ref","policy_configuration","model_runtime_configuration","runtime_environment","canonical_evidence_ref","metrics","treatment_blinding","failure_classification","status","stopping_rule_hash","evidence_hashes","metric_artifact_hash","reason","created_at","attestation","evidence_artifact","evidence_artifact_hash","metric_artifact"],
  "properties":{
    "schema_version":{"const":"phase-a-calibration-manifest-2.0.0"},"tooling_version":{"const":"phase-a-calibration-tooling-1.1.0"},"calibration_run_id":{"type":"string"},"attempt_id":{"type":"string"},
    "implementation_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"implementation_tag":{"const":"v0.1.0-pilot0"},"tooling_distribution_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"baseline_tag_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"release_descriptor_hash":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
    "protocol_version":{"type":"string"},"protocol_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"specification_versions":{"type":"object"},"parameter_registry_version":{"type":"string"},"parameter_registry_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"parameter_set":{"type":"object"},
    "parameter_set_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"parameter_classifications":{"type":"object"},
    "seed":{"type":"string"},"seeds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "execution_intent_id":{"type":"string"},"execution_request_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "rng_provenance_ref":{"type":"string"},"policy_configuration":{"type":"object"},"model_runtime_configuration":{"type":"object"},
    "runtime_environment":{"type":"object"},"canonical_evidence_ref":{"type":"string"},"metrics":{"type":"object","additionalProperties":{"type":"object"}},
    "metric_definition_registry_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"evidence_trust_proof":{"type":"object"},
    "treatment_blinding":{"const":"CALIBRATION_TREATMENT_BLIND_V1"},
    "failure_classification":{"enum":["PARAMETER_FAILURE","IMPLEMENTATION_DEFECT","PROTOCOL_VIOLATION","BLINDING_BREACH","INFRASTRUCTURE_FAILURE","RESEARCH_DESIGN_BLOCKER","ACCEPTED_CONFIGURATION"]},
    "status":{"enum":["PARAMETER_FAILURE","IMPLEMENTATION_DEFECT","PROTOCOL_VIOLATION","BLINDING_BREACH","INFRASTRUCTURE_FAILURE","RESEARCH_DESIGN_BLOCKER","ACCEPTED_CONFIGURATION"]},
    "stopping_rule_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"evidence_hashes":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "metric_artifact_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"reason":{"type":"string"},"created_at":{"type":"string"},
    "attestation":{"type":"object"},"evidence_artifact":{"type":"string"},"evidence_artifact_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"metric_artifact":{"type":"string"}
  }
}
