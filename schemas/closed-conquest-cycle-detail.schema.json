{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://civilization-lab.invalid/schemas/closed-conquest-cycle-detail.schema.json",
  "type":"object","additionalProperties":false,
  "required":["mechanic_version","cycle_members","elimination_predicates","asset_transition_event_ids","elimination_event_ids","resolution"],
  "properties":{
    "mechanic_version":{"const":"world-v2"},
    "cycle_members":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string"}},
    "elimination_predicates":{"type":"array","minItems":2,"items":{"type":"object"}},
    "asset_transition_event_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "elimination_event_ids":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string"}},
    "resolution":{"const":"simultaneous_no_successor"}
  }
}
