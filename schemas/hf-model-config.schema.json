{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civilization-lab.invalid/schemas/hf-model-config.schema.json",
  "title": "Pilot 0 explicitly selected HF Base configuration (not empirical admission)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "repository", "revision", "model_kind", "runtime", "dtype", "device", "quantization", "model_artifact_hash", "tokenizer_hash", "runtime_hash", "generation", "context_budget", "max_attempts", "attempt_timeout_ms", "parameter_status", "calibration_status", "chat_template", "credential_environment_variable", "status", "confirmatory_frozen", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source": {"const": "huggingface"},
    "repository": {"type": "string", "pattern": "^Qwen/Qwen3\\.5-[0-9]+(?:\\.[0-9]+)?B(?:-A[0-9]+(?:\\.[0-9]+)?B)?-Base$"},
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "model_kind": {"const": "base"},
    "runtime": {"enum": ["mlx-lm", "transformers"]},
    "dtype": {"enum": ["checkpoint", "float32", "float16", "bfloat16"]},
    "device": {"type": "string", "pattern": "^(metal|cpu|mps|cuda(?::[0-9]+)?)$"},
    "python": {"type": "string", "minLength": 1},
    "quantization": {"const": "none"},
    "model_artifact_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "tokenizer_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "runtime_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "artifact_manifest": {"type": "object", "required": ["artifacts", "runtime_manifest", "runtime_hash", "generation_performed", "weights_loaded"]},
    "generation": {"type": "object", "additionalProperties": false, "required": ["temperature", "top_p", "max_tokens", "seed"], "properties": {
      "temperature": {"type": "number", "minimum": 0, "maximum": 2},
      "top_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
      "max_tokens": {"type": "integer", "minimum": 1}, "seed": {"type": "integer"}
    }},
    "context_budget": {"type": "integer", "minimum": 1},
    "max_attempts": {"type": "integer", "minimum": 1},
    "attempt_timeout_ms": {"type": "integer", "minimum": 1},
    "parameter_status": {"const": "PROVISIONAL"},
    "calibration_status": {"const": "PILOT_0_CALIBRATION_REQUIRED"},
    "chat_template": {"const": "disabled_raw_completion"},
    "credential_environment_variable": {"const": "HF_TOKEN"},
    "status": {"type": "string", "minLength": 1},
    "confirmatory_frozen": {"const": false},
    "provenance": {"type": "string", "minLength": 1}
  }
}
