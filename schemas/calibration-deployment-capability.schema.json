{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calibration-deployment-capability.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mode", "issued_at", "implementation_commit", "implementation_tag", "baseline_tag_commit", "tooling_version", "calibration_tooling_commit", "protocol_hash", "parameter_registry_hash", "parameter_domain_hash", "tooling_distribution_digest", "release_descriptor_hash", "deployment_trust_policy_hash", "execution_scope", "prohibited_scopes", "seed_panel_hash", "max_turns", "not_before_ms", "expires_at_ms", "revocation", "model_runtime_lock_hash", "key_id", "adapter_hash", "policy_manifest", "policy_manifest_hash", "evidence_key_id", "evidence_head_key_id", "archive_key_id", "attestor_key_id", "evidence_endpoint", "archive_destination_hash", "campaign_id", "calibration_run_id", "adapter_executable", "public_key", "signature"],
  "properties": {
    "version": {"const": "phase-a-empirical-authorization-1.0.0"},
    "mode": {"const": "EMPIRICAL_CALIBRATION"},
    "issued_at": {"type": "string", "minLength": 20},
    "implementation_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "implementation_tag": {"const": "v0.1.0-pilot0"},
    "baseline_tag_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "tooling_version": {"const": "phase-a-calibration-tooling-1.1.0"},
    "calibration_tooling_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "protocol_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parameter_registry_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parameter_domain_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tooling_distribution_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "release_descriptor_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "deployment_trust_policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "execution_scope": {"const": "PHASE_A_WORLD_CALIBRATION"},
    "prohibited_scopes": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["PILOT_0_RESEARCH", "QWEN_ECOLOGICAL_VALIDATION", "HUMAN_SESSIONS", "PERSISTENCE_TREATMENT_ANALYSIS", "CONFIRMATORY_RESEARCH", "ORGANIZATION_MECHANICS", "STATISTICAL_FREEZE_112"]}},
    "seed_panel_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "max_turns": {"const": 20},
    "not_before_ms": {"type": "integer", "minimum": 0},
    "expires_at_ms": {"type": "integer", "minimum": 1},
    "revocation": {"type": "object", "additionalProperties": false, "required": ["status", "registry_ref", "registry_hash", "checked_at_dispatch"], "properties": {"status": {"const": "NOT_REVOKED_AT_ISSUANCE"}, "registry_ref": {"const": "calibration-revocations.json"}, "registry_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "checked_at_dispatch": {"const": true}}},
    "model_runtime_lock_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "key_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "adapter_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_manifest": {"type": "object"},
    "policy_manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_key_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_head_key_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "archive_key_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "attestor_key_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_endpoint": {"type": "string", "pattern": "^https://"},
    "archive_destination_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "campaign_id": {"type": "string", "minLength": 1},
    "calibration_run_id": {"type": "string", "minLength": 1},
    "predecessor_failed_campaign": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_type", "disposition", "campaign_id", "calibration_run_id", "archive_head", "archive_tree_digest", "disposition_record_hash", "parameter_vectors_successfully_evaluated", "calibration_seeds_completed", "imported_completed_keys"],
      "properties": {
        "reference_type": {"const": "PREDECESSOR_FAILED_CAMPAIGN"},
        "disposition": {"const": "FAILED_PRE_CALIBRATION_EXECUTION"},
        "campaign_id": {"type": "string", "minLength": 1},
        "calibration_run_id": {"type": "string", "minLength": 1},
        "archive_head": {"type": "object", "additionalProperties": false, "required": ["generation", "digest"], "properties": {"generation": {"type": "integer", "minimum": 0}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
        "archive_tree_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "disposition_record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "parameter_vectors_successfully_evaluated": {"const": 0},
        "calibration_seeds_completed": {"const": 0},
        "imported_completed_keys": {"type": "array", "maxItems": 0}
      }
    },
    "adapter_executable": {"type": "object"},
    "public_key": {"type": "string", "minLength": 80},
    "signature": {"type": "string", "minLength": 80}
  }
}
